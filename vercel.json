{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "framework": null,
  "installCommand": "npm install",
  "functions": {
    "api/pix.ts": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "api/_pix_gateway.cjs"
    }
  },
  "rewrites": [
    { "source": "/api/pix", "destination": "/api/pix?path=health" },
    { "source": "/api/pix/(.*)", "destination": "/api/pix?path=$1" },
    { "source": "/pix", "destination": "/pix/index.html" },
    { "source": "/pix/", "destination": "/pix/index.html" },
    { "source": "/maciel-motors-x/(.*)", "destination": "/maciel-motors-x/index.html" },
    { "source": "/maciel-motors/(.*)", "destination": "/maciel-motors/index.html" },
    { "source": "/porthal-imoveis/(.*)", "destination": "/porthal-imoveis/index.html" },
    { "source": "/marcio-mariano/(.*)", "destination": "/marcio-mariano/index.html" },
    { "source": "/sogov/(.*)", "destination": "/sogov/index.html" },
    { "source": "/clinica-dna/(.*)", "destination": "/clinica-dna/index.html" },
    { "source": "/dr-marcelo-prado/(.*)", "destination": "/dr-marcelo-prado/index.html" },
    { "source": "/clinica-harmonie/(.*)", "destination": "/clinica-harmonie/index.html" },
    { "source": "/octavio-pucci/(.*)", "destination": "/octavio-pucci/index.html" },
    { "source": "/na-veiculos/(.*)", "destination": "/na-veiculos/index.html" },
    { "source": "/clinica-matsubara/(.*)", "destination": "/clinica-matsubara/index.html" },
    { "source": "/danielle-matsubara/(.*)", "destination": "/danielle-matsubara/index.html" },
    { "source": "/gl-locacoes/(.*)", "destination": "/gl-locacoes/index.html" },
    { "source": "/protocolo-pav/(.*)", "destination": "/protocolo-pav/index.html" },
    { "source": "/((?!api(?:/|$)|pix(?:/|$)|maciel-motors-x|maciel-motors|porthal-imoveis|marcio-mariano|sogov|clinica-dna|dr-marcelo-prado|clinica-harmonie|octavio-pucci|na-veiculos|clinica-matsubara|danielle-matsubara|gl-locacoes|protocolo-pav|cbx|assets|favicon|icons).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
