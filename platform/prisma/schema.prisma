generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum PartnerStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum SaleStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships               OrganizationMembership[]
  sessions                  Session[]
  partners                  Partner[]
  leadInteractions          LeadInteraction[]
  opportunityStageHistories OpportunityStageHistory[]
  crmInteractions           CrmInteraction[]
  salesPaid                 Sale[]                    @relation("SalePaidBy")

  @@map("users")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  memberships   OrganizationMembership[]
  activeSessions Session[]              @relation("ActiveOrganization")
  roles          Role[]
  partners       Partner[]
  products       Product[]
  offers         Offer[]
  leads          Lead[]
  pipelines      Pipeline[]
  opportunities  Opportunity[]
  customers      Customer[]
  sales          Sale[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membershipRoles MembershipRole[]

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  tokenHash            String   @unique @map("token_hash")
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  expiresAt            DateTime @map("expires_at")
  createdAt            DateTime @default(now()) @map("created_at")

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Role {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  name           String
  slug           String
  description    String?
  status         RoleStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id           String   @id @default(uuid()) @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
  @@map("membership_roles")
}

model Partner {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  name           String
  legalName      String?       @map("legal_name")
  document       String?
  email          String?
  phone          String?
  status         PartnerStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  leads         Lead[]
  opportunities Opportunity[]
  customers     Customer[]
  sales         Sale[]

  @@unique([organizationId, userId])
  @@unique([organizationId, document])
  @@index([organizationId])
  @@index([status])
  @@map("partners")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String
  slug           String
  description    String?
  category       String?
  status         CatalogStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offers       Offer[]
  sales        Sale[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@map("products")
}

model Offer {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  name           String
  slug           String
  description    String?
  price          Decimal       @db.Decimal(15, 2)
  currency       String        @default("BRL")
  status         CatalogStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  sales        Sale[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([productId])
  @@index([status])
  @@map("offers")
}

enum LeadInteractionType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  OTHER
}

model Lead {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  partnerId      String?  @map("partner_id") @db.Uuid
  name           String
  companyName    String?  @map("company_name")
  email          String?
  phone          String?
  document       String?
  notes          String?
  source         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partner       Partner?           @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  interactions  LeadInteraction[]
  opportunities Opportunity[]
  customers     Customer[]
  sales         Sale[]

  @@index([organizationId])
  @@index([partnerId])
  @@index([source])
  @@map("leads")
}

model LeadInteraction {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  leadId          String              @map("lead_id") @db.Uuid
  type            LeadInteractionType
  description     String
  occurredAt      DateTime            @map("occurred_at")
  createdByUserId String              @map("created_by_user_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([leadId])
  @@map("lead_interactions")
}

enum CrmInteractionType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  MEETING
  PROPOSAL
  OTHER
}

model Pipeline {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([organizationId])
  @@map("pipelines")
}

model PipelineStage {
  id             String   @id @default(uuid()) @db.Uuid
  pipelineId     String   @map("pipeline_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  position       Int
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pipeline      Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  historyFrom   OpportunityStageHistory[] @relation("FromStage")
  historyTo     OpportunityStageHistory[] @relation("ToStage")

  @@unique([pipelineId, position])
  @@index([organizationId])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

model Opportunity {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  leadId          String    @map("lead_id") @db.Uuid
  partnerId       String?   @map("partner_id") @db.Uuid
  pipelineId      String    @map("pipeline_id") @db.Uuid
  stageId         String    @map("stage_id") @db.Uuid
  title           String
  description     String?
  amount          Decimal?  @db.Decimal(15, 2)
  probability     Int?
  expectedCloseAt DateTime? @map("expected_close_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Restrict)
  partner      Partner?     @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage        PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  stageHistory OpportunityStageHistory[]
  interactions CrmInteraction[]
  sales        Sale[]

  @@index([organizationId])
  @@index([leadId])
  @@index([partnerId])
  @@index([pipelineId])
  @@index([stageId])
  @@map("opportunities")
}

model OpportunityStageHistory {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  opportunityId   String   @map("opportunity_id") @db.Uuid
  fromStageId     String?  @map("from_stage_id") @db.Uuid
  toStageId       String   @map("to_stage_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  opportunity Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage   PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage     PipelineStage  @relation("ToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  user        User           @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([opportunityId])
  @@map("opportunity_stage_history")
}

model CrmInteraction {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  opportunityId   String             @map("opportunity_id") @db.Uuid
  type            CrmInteractionType
  description     String
  occurredAt      DateTime           @map("occurred_at")
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([opportunityId])
  @@map("crm_interactions")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  leadId         String?        @map("lead_id") @db.Uuid
  partnerId      String?        @map("partner_id") @db.Uuid
  name           String
  legalName      String?        @map("legal_name")
  document       String?
  email          String?
  phone          String?
  companyName    String?        @map("company_name")
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  partner      Partner?     @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  sales        Sale[]

  @@unique([organizationId, document])
  @@unique([organizationId, leadId])
  @@index([organizationId])
  @@index([partnerId])
  @@index([status])
  @@index([email])
  @@map("customers")
}

model Sale {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  leadId              String?    @map("lead_id") @db.Uuid
  customerId          String     @map("customer_id") @db.Uuid
  opportunityId       String?    @map("opportunity_id") @db.Uuid
  partnerId           String?    @map("partner_id") @db.Uuid
  productId           String     @map("product_id") @db.Uuid
  offerId             String     @map("offer_id") @db.Uuid
  status              SaleStatus @default(DRAFT)
  productNameSnapshot String     @map("product_name_snapshot")
  offerNameSnapshot   String     @map("offer_name_snapshot")
  listPrice           Decimal    @map("list_price") @db.Decimal(15, 2)
  finalPrice          Decimal    @map("final_price") @db.Decimal(15, 2)
  currency            String     @default("BRL")
  soldAt              DateTime?  @map("sold_at")
  paidAt              DateTime?  @map("paid_at")
  paidByUserId        String?    @map("paid_by_user_id") @db.Uuid
  paymentMethod       String?    @map("payment_method")
  paymentReference    String?    @map("payment_reference")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  opportunity  Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  partner      Partner?     @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  offer        Offer        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  paidBy       User?        @relation("SalePaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([customerId])
  @@index([leadId])
  @@index([opportunityId])
  @@index([partnerId])
  @@index([offerId])
  @@index([status])
  @@index([soldAt])
  @@index([paidAt])
  @@map("sales")
}
