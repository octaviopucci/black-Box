# Black Box Platform — environment variables
# Copy to .env and fill in values. Never commit .env.

DATABASE_URL=postgresql://blackbox:blackbox@localhost:5432/blackbox_platform?schema=public
NODE_ENV=development
LOG_LEVEL=info

# Required — min 32 chars. Generate: openssl rand -base64 32
AUTH_SECRET=

SESSION_MAX_AGE_SECONDS=604800

# Bootstrap (optional — used by npm run db:bootstrap)
BOOTSTRAP_ORG_NAME=Black Box
BOOTSTRAP_ORG_SLUG=black-box
BOOTSTRAP_USER_NAME=Platform Admin
BOOTSTRAP_USER_EMAIL=admin@blackbox.local
BOOTSTRAP_USER_PASSWORD=change-me-now
