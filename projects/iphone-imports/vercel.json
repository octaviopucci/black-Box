{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci --include=dev && npm --prefix gestor ci --include=dev",
  "outputDirectory": "out",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "framework": null,
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "out" }
    },
    {
      "src": "api/dist/handler.cjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/iphone-imports", "dest": "/api/dist/handler.cjs" },
    { "src": "/api/iphone-imports/(.*)", "dest": "/api/dist/handler.cjs?path=$1" },
    { "handle": "filesystem" },
    { "src": "/gestor", "dest": "/gestor/index.html" },
    { "src": "/gestor/(.*)", "dest": "/gestor/index.html" }
  ]
}
