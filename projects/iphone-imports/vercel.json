{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm ci --include=dev && npm --prefix gestor ci --include=dev && npm --prefix ../w-tube ci --include=dev && npm --prefix ../w-tube/gestor ci --include=dev",
  "outputDirectory": "out",
  "cleanUrls": true,
  "ignoreCommand": "bash ./scripts/vercel-ignore-build.sh",
  "framework": null,
  "fluid": true,
  "functions": {
    "api/iphone-imports.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/w-tube.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/lp-motors.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/mesaflow.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/gestor", "destination": "/iphone-imports/gestor", "permanent": true },
    { "source": "/gestor/:path*", "destination": "/iphone-imports/gestor/:path*", "permanent": true },
    { "source": "/produto/:slug", "destination": "/iphone-imports/produto/:slug", "permanent": true },
    { "source": "/categoria/:slug", "destination": "/iphone-imports/categoria/:slug", "permanent": true },
    { "source": "/ofertas", "destination": "/iphone-imports/ofertas", "permanent": true },
    { "source": "/buscar", "destination": "/iphone-imports/buscar", "permanent": true },
    { "source": "/carrinho", "destination": "/iphone-imports/carrinho", "permanent": true },
    { "source": "/checkout", "destination": "/iphone-imports/checkout", "permanent": true },
    { "source": "/favoritos", "destination": "/iphone-imports/favoritos", "permanent": true },
    { "source": "/contato", "destination": "/iphone-imports/contato", "permanent": true },
    { "source": "/sobre", "destination": "/iphone-imports/sobre", "permanent": true },
    { "source": "/termos", "destination": "/iphone-imports/termos", "permanent": true },
    { "source": "/politica-de-privacidade", "destination": "/iphone-imports/politica-de-privacidade", "permanent": true },
    { "source": "/trocas-e-devolucoes", "destination": "/iphone-imports/trocas-e-devolucoes", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/iphone-imports", "destination": "/api/iphone-imports?path=health" },
    { "source": "/api/iphone-imports/(.*)", "destination": "/api/iphone-imports?path=$1" },
    { "source": "/api/w-tube", "destination": "/api/w-tube?path=health" },
    { "source": "/api/w-tube/(.*)", "destination": "/api/w-tube?path=$1" },
    { "source": "/api/lp-motors", "destination": "/api/lp-motors?path=health" },
    { "source": "/api/lp-motors/(.*)", "destination": "/api/lp-motors?path=$1" },
    { "source": "/api/mesaflow", "destination": "/api/mesaflow?path=health" },
    { "source": "/api/mesaflow/(.*)", "destination": "/api/mesaflow?path=$1" },
    { "source": "/pucci-motors", "destination": "/pucci-motors/index.html" },
    { "source": "/pucci-motors/(.*)", "destination": "/pucci-motors/index.html" },
    { "source": "/b2-gestor", "destination": "/b2-gestor/index.html" },
    { "source": "/b2-gestor/(.*)", "destination": "/b2-gestor/index.html" },
    { "source": "/iphone-imports/gestor", "destination": "/iphone-imports/gestor/index.html" },
    { "source": "/iphone-imports/gestor/((?!assets/).*)", "destination": "/iphone-imports/gestor/index.html" },
    { "source": "/iphone-imports/produto/:slug", "destination": "/iphone-imports/produto/__live__" },
    { "source": "/w-tube", "destination": "/w-tube/index.html" },
    { "source": "/w-tube/gestor", "destination": "/w-tube/gestor/index.html" },
    { "source": "/w-tube/gestor/((?!assets/).*)", "destination": "/w-tube/gestor/index.html" },
    { "source": "/w-tube/produto/:slug", "destination": "/w-tube/produto/__live__" },
    { "source": "/mesaflow", "destination": "/mesaflow/index" },
    { "source": "/mesaflow/admin/login", "destination": "/mesaflow/admin/login" },
    { "source": "/mesaflow/admin/signup", "destination": "/mesaflow/admin/signup" },
    { "source": "/mesaflow/admin/orders", "destination": "/mesaflow/admin/orders" },
    { "source": "/mesaflow/admin/products", "destination": "/mesaflow/admin/products" },
    { "source": "/mesaflow/admin/settings", "destination": "/mesaflow/admin/settings" },
    { "source": "/mesaflow/admin/tables", "destination": "/mesaflow/admin/tables" },
    { "source": "/mesaflow/admin/qrcodes", "destination": "/mesaflow/admin/qrcodes" },
    { "source": "/mesaflow/admin", "destination": "/mesaflow/admin" },
    { "source": "/mesaflow/platform/login", "destination": "/mesaflow/platform/login" },
    { "source": "/mesaflow/platform/merchants/detail", "destination": "/mesaflow/platform/merchants/detail" },
    { "source": "/mesaflow/platform/merchants", "destination": "/mesaflow/platform/merchants" },
    { "source": "/mesaflow/platform", "destination": "/mesaflow/platform" },
    { "source": "/mesaflow/privacidade", "destination": "/mesaflow/privacidade" },
    { "source": "/mesaflow/kds/live", "destination": "/mesaflow/kds/live" },
    { "source": "/mesaflow/kds/:sector", "destination": "/mesaflow/kds/live" },
    { "source": "/mesaflow/m/live", "destination": "/mesaflow/m/live" },
    { "source": "/mesaflow/m/:slug/:table", "destination": "/mesaflow/m/live" }
  ]
}
