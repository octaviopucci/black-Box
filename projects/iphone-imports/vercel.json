{
  "version": 2,
  "installCommand": "npm ci --include=dev && npm --prefix gestor ci --include=dev",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "out" }
    },
    {
      "src": "api/iphone-imports.ts",
      "use": "@vercel/node",
      "config": { "includeFiles": "api/_iphone-imports/**" }
    }
  ],
  "routes": [
    { "src": "/api/iphone-imports", "dest": "/api/iphone-imports?path=health" },
    { "src": "/api/iphone-imports/(.*)", "dest": "/api/iphone-imports?path=$1" },
    { "handle": "filesystem" },
    { "src": "/gestor", "dest": "/gestor/index.html" },
    { "src": "/gestor/(.*)", "dest": "/gestor/index.html" }
  ]
}
