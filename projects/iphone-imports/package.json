{
  "name": "iphone-imports",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:gestor": "npm --prefix gestor run dev",
    "build": "next build",
    "build:gestor": "VITE_BASE=/gestor/ npm --prefix gestor run build && node scripts/copy-gestor.mjs",
    "build:deploy": "npm run build && npm run build:gestor",
    "test:api": "npx --yes tsx api/_iphone-imports/catalog.test.ts && npx --yes tsx api/_iphone-imports/integration.test.ts",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "@vercel/node": "^5.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
