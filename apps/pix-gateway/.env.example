# API key usada pelos seus apps para chamar o gateway
PIX_GATEWAY_API_KEY=change-me-to-a-long-secret

# Porta HTTP
PORT=8787

# Caminho do banco SQLite (criado automaticamente)
DATABASE_PATH=./data/pix-gateway.db

# Ambiente: development | production
NODE_ENV=development

# URL pública do gateway (usada em docs/logs; webhooks Asaas apontam para cá)
# Ex.: https://seu-dominio.com ou http://localhost:8787
PUBLIC_BASE_URL=http://localhost:8787
