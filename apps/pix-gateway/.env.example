# API key usada pelos seus apps / painel /pix para chamar o gateway
PIX_GATEWAY_API_KEY=change-me-to-a-long-secret

# Porta HTTP (dev local)
PORT=8787

# Store JSON (criado automaticamente)
DATABASE_PATH=./data/pix-gateway-store.json

# Ambiente: development | production
NODE_ENV=development

# URL pública (produção: https://blckbox.vercel.app)
PUBLIC_BASE_URL=http://localhost:8787

# Na Vercel fica /api/pix automaticamente
# API_PREFIX=/api/pix

# Persistência entre cold starts (Vercel Blob — criado no dashboard)
# BLOB_READ_WRITE_TOKEN=
